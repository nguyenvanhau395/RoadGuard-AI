# Sao chép file này thành .roadguard.env rồi điền khóa thật.
CHATBOT_API_KEY=your-api-key
CHATBOT_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=gpt-4.1-mini

# Gmail SMTP: dùng App Password 16 ký tự, không dùng mật khẩu Gmail thường.
REPORT_SMTP_HOST=smtp.gmail.com
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=report@example.com
REPORT_SMTP_PASSWORD=your-16-character-app-password
REPORT_SMTP_FROM=report@example.com
REPORT_SMTP_TLS=1
