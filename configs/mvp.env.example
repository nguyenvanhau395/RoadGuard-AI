# Không điền secret vào Git hoặc vào file này.
# PowerShell: $env:CHATBOT_API_KEY = "<api-key-moi>"
CHATBOT_BASE_URL=https://api.openai.com/v1
CHATBOT_MODEL=gpt-4.1-mini

# Email tùy chọn
REPORT_SMTP_HOST=smtp.example.com
REPORT_SMTP_PORT=587
REPORT_SMTP_USER=report@example.com
REPORT_SMTP_PASSWORD=<smtp-password>
REPORT_SMTP_FROM=report@example.com
REPORT_SMTP_TLS=1
